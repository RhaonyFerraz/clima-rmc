# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados
DB_PATH=./data/clima_rmc.db

# Configurações de Provedores de Clima
# Por padrão, usa 'open-meteo' (100% gratuito e sem chave)
WEATHER_PROVIDER=open-meteo

# Caso queira usar Google Weather / Google Maps Weather API, preencha:
GOOGLE_WEATHER_API_KEY=
